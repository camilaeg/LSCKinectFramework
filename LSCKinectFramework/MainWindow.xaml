
<Window x:Class="LSCKinectFramework.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect - Reconocimiento LSC"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Estado de conexión -->
        <TextBlock x:Name="EstadoKinect"
                   Text="Iniciando Kinect..."
                   Foreground="White"
                   FontSize="18"
                   Margin="12"/>

        <!-- Imagen de la cámara -->
        <Border Grid.Row="1"
                Margin="12"
                Background="Black">
            <Image x:Name="ImagenKinect"
                   Stretch="Uniform"/>
        </Border>

        <!-- Coordenadas de las manos -->
        <TextBlock x:Name="DatosManos"
                   Grid.Row="2"
                   Text="Esperando detección del cuerpo..."
                   Foreground="LightGreen"
                   FontSize="15"
                   Margin="12"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
